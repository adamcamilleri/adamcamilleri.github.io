# Copy to .env and fill in your keys
# Required for Handoff chat:
GROQ_API_KEY=your_groq_api_key

# Optional – for deploy button:
VERCEL_TOKEN=your_vercel_token

# Optional – for payment links:
STRIPE_SECRET_KEY=your_stripe_secret_key

# Optional – for Save design (MongoDB Atlas free tier):
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/handoff

# Optional – for programmatic API access (Postman, scripts). Comma-separated keys.
# If set and request includes X-API-Key, it must match. No key = allowed.
# API_KEYS=dev-key-123,prod-key-456
