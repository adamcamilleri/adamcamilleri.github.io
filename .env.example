# Copy to .env and fill in your keys

# QueryDesk (projects/querydesk) SQL generation. See projects/querydesk/.env.example.
ANTHROPIC_API_KEY=your_anthropic_api_key

# Optional – for Songdle persistence (MongoDB Atlas free tier):
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/portfolio

# Optional – for programmatic API access (Postman, scripts). Comma-separated keys.
# If set and request includes X-API-Key, it must match. No key = allowed.
# API_KEYS=dev-key-123,prod-key-456
