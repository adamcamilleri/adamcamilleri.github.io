# Anthropic API key for SQL generation. The app runs without it: generation
# shows a banner, everything else (catalog, manual SQL, export) works.
ANTHROPIC_API_KEY=

# Optional: override where app.db and demo_mars.db are created.
# QUERYDESK_DATA_DIR=

# Optional: generation requests allowed per client IP per hour on public
# deploys. Default 20; 0 disables the limit.
# QUERYDESK_ASK_LIMIT_PER_HOUR=20
